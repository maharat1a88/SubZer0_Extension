{
  "manifest_version": 3,
  "name": "SubZer0 Extension",
  "version": "1.0",
  "description": "A Chrome extension built by ASHBY.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ]
}